#!/usr/bin/env node
import { run } from '../src/cli.js';

// `run` is async (the conscience surface loads the project's own loop-runtime). Surface any
// escaped rejection as a one-line error + exit 1, never a raw stack trace at a founder.
run(process.argv.slice(2)).catch((e) => {
  console.error(`  Error ${e && e.message ? e.message : e}`);
  process.exit(1);
});
