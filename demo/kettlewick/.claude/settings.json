{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/design-tokens-guard.js\"", "timeout": 5 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/contrast-guard.js\"", "timeout": 5 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/component-reuse-guard.js\"", "timeout": 5 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/design-decisions-guard.js\"", "timeout": 5 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/content-terminology-guard.js\"", "timeout": 5 }
        ]
      }
    ]
  }
}
