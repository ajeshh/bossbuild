{
  "$description": "Kettlewick design tokens — W3C DTCG. The one file a colour is a fact in. The stack file (src/styles/tokens.css) is derived from this; never edit it by hand.",
  "color": {
    "surface": {
      "ground": {
        "$type": "color",
        "$value": "#E6EBE3",
        "$description": "the page — a pale sage, never pure white, so paper reads as raised"
      },
      "paper": {
        "$type": "color",
        "$value": "#F5F7F2",
        "$description": "a bounded thing on the ground: a card, a row, a dialog"
      },
      "raised": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "paper with shadow.raised — used only by things that float"
      }
    },
    "text": {
      "body": {
        "$type": "color",
        "$value": "#1B2A22",
        "$description": "green-black, not black — DEC-004"
      },
      "muted": {
        "$type": "color",
        "$value": "#536159",
        "$description": "secondary text; still AA on ground and paper"
      },
      "on-primary": {
        "$type": "color",
        "$value": "#FFF7F0",
        "$description": "text on color.action.primary"
      },
      "on-danger": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "placeholder": {
        "$type": "color",
        "$value": "#9AA5A1",
        "$deprecated": "color.text.muted",
        "$description": "retired 2026-08-30: failed AA on paper; use muted"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "#A84D18",
        "$description": "the kettle copper — the one owned accent, DEC-004"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "#8F4013",
        "$description": "primary mixed 12% with text.body"
      },
      "danger": {
        "$type": "color",
        "$value": "#A33A2E",
        "$description": "the confirm on a destructive dialog, nowhere else"
      }
    },
    "signal": {
      "uncovered": {
        "$type": "color",
        "$value": "#9A5E14",
        "$description": "a visit nobody has — amber, never red (principle 1)"
      },
      "asked": {
        "$type": "color",
        "$value": "#536159",
        "$description": "three carers have the ask; waiting is quiet"
      },
      "covered": {
        "$type": "color",
        "$value": "#2E6B4F",
        "$description": "done — the accent, because covered is the act"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "#BFC9BE"
      },
      "subtle": {
        "$type": "color",
        "$value": "#D8E0D5"
      }
    },
    "gray": {
      "100": {
        "$type": "color",
        "$value": "#E6EBE3"
      },
      "300": {
        "$type": "color",
        "$value": "#BFC9BE"
      },
      "500": {
        "$type": "color",
        "$value": "#536159"
      },
      "900": {
        "$type": "color",
        "$value": "#1B2A22"
      }
    }
  },
  "font": {
