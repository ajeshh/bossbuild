{
  "name": "oyeboss",
  "version": "0.179.0",
  "description": "BOSS (Build Out Solid Stuff) — a just-in-time startup incubator that cold-starts projects at the right level of agentic ceremony, grows them through modes (Quickstart → MVP → V1 → Scale), and mentors the founder. Make it real.",
  "keywords": [
    "Agentic",
    "framework",
    "humanetech"
  ],
  "homepage": "https://github.com/ajeshh/bossbuild#readme",
  "bugs": {
    "url": "https://github.com/ajeshh/bossbuild/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajeshh/bossbuild.git"
  },
  "license": "MIT",
  "author": "Ajesh Shah",
  "type": "module",
  "bin": {
    "boss": "bin/boss"
  },
  "directories": {
    "doc": "docs"
  },
  "files": [
    "bin/",
    "src/",
    "stages/",
    "library/",
    "VERSION",
    "PRINCIPLES.md",
    "registry/CHANGELOG.md",
    "registry/supersedes.json"
  ],
  "scripts": {
    "link": "npm install -g .",
    "gen:docs": "node scripts/gen-docs.js",
    "gen:site": "node scripts/gen-site.js",
    "check:wayfinding": "node scripts/check-wayfinding-drift.js",
    "check:manifests": "node scripts/check-manifests.js",
    "check:freshness": "node scripts/check-freshness.js",
    "check:refs": "node scripts/check-refs.js",
    "check:boundary": "node scripts/check-boundary.js",
    "check:site": "node scripts/check-site.js",
    "test": "node scripts/check-refs.js && node scripts/check-boundary.js && node scripts/check-ladder.js && node --test test/*.test.js",
    "release": "node scripts/release.js",
    "pack:preview": "npm pack --dry-run",
    "eval:gate": "node docs/architecture/conscience-evals/runner.js",
    "eval:judgment": "node docs/architecture/conscience-evals/judgment/replay.js",
    "eval": "npm run eval:gate && npm run eval:judgment",
    "regrade": "node docs/architecture/conscience-evals/judgment/regrade.js",
    "regrade:keyless": "node docs/architecture/conscience-evals/judgment/regrade-keyless.js",
    "gen:surface-freshness": "node scripts/gen-surface-freshness.js",
    "check:ladder": "node scripts/check-ladder.js"
  },
  "engines": {
    "node": ">=18"
  }
}
